# ── HoLa Kiosk (appended by deploy/install.sh — do not duplicate) ──────────
# Official Raspberry Pi 7" DSI touchscreen needs no overlay on Bookworm;
# vc4-kms-v3d is enabled by default. Portrait mounting is easier to solve
# in the kiosk session than here — see README "Display rotation".
#
# HiFiBerry DAC (classic) — sound output for optional audible alerts
dtoverlay=hifiberry-dac
