[Unit]
Description=HoLa Kiosk status-page proxy (strips X-Frame-Options so the
             kiosk page can embed the upstream status page)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__TARGET__/HoLa_Kiosk/deploy
# upstream status service — SET THIS to your instance (preserved across
# re-installs once customized)
Environment=STATUS_PROXY_TARGET=__STATUS_TARGET__
ExecStart=__TARGET__/venv/bin/uvicorn status_proxy:app --host 127.0.0.1 --port 8601
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
