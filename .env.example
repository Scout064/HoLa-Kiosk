# HoLa Kiosk — secrets (loaded by the HoLa-Dash backend via ${VAR} references
# in config/settings.yaml). Copy to `.env` and fill in.

# Proxmox VE API token — read-only token is sufficient for the kiosk
PROXMOX_TOKEN_NAME=
PROXMOX_TOKEN_VALUE=

# Pi-hole web/app password (leave PIHOLE_PASSWORD empty if your Pi-hole
# has no password set — its API is open then)
PIHOLE_PASSWORD=

# Optional shared secret if you open web.host to the LAN (usually empty:
# the kiosk backend binds to 127.0.0.1 only)
HOLA_API_KEY=
